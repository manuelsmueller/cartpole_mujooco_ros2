<mujoco model="cartpole_primitive">
  <compiler angle="radian"/>
  <option timestep="0.01" gravity="0 0 -9.81"/>

  <!-- MuJoCo prueft standardmaessig alle Body-Paare auf Kollision.
       Rail, Cart und Pole sind durch Gelenke gefuehrt, echter Kontakt ist nicht gewollt. -->
  <contact>
    <exclude body1="rail" body2="cart"/>
    <exclude body1="cart" body2="pole"/>
    <exclude body1="rail" body2="pole"/>
  </contact>

  <worldbody>
    <light diffuse="0.6 0.6 0.6" pos="0 0 3" dir="0 0 -1"/>
    <geom type="plane" size="3 3 0.1" rgba="0.85 0.85 0.85 1"/>

    <body name="rail" pos="0 0 1.0">
      <geom type="box" size="2.0 0.025 0.025" rgba="0.6 0.6 0.6 1" mass="50"/>

      <!-- Cart liegt oberhalb der Rail: 0.025 (Rail-Halbhoehe) + 0.075 (Cart-Halbhoehe) -->
      <body name="cart" pos="0 0 0.10">
        <joint name="slider_to_cart" type="slide" axis="1 0 0"
               range="-1.8 1.8" damping="0.05"/>
        <geom type="box" size="0.15 0.1 0.075" rgba="0.1 0.1 0.8 1" mass="1.0"/>

        <!-- Anfangsauslenkung wird von der Simulation per qpos gesetzt (Parameter reset_angle) -->
        <body name="pole" pos="0 0 0.075">
          <joint name="cart_to_pole" type="hinge" axis="0 1 0" damping="0.01"/>
          <geom type="cylinder" fromto="0 0 0  0 0 1.0" size="0.02"
                rgba="0.8 0.1 0.1 1" mass="0.1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="cart_motor" joint="slider_to_cart" ctrlrange="-60 60" gear="1"/>
  </actuator>
</mujoco>
